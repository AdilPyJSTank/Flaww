# ─── Runtime ────────────────────────────────────────────────────────────────
# Cloud Run injects PORT. Only set it locally.
PORT=8080
# The public https URL of the service. flaww registers its own Telegram
# webhook against this on boot, so a redeploy to a new URL self-heals.
PUBLIC_URL=https://flaww-xxxxxxxx-ew.a.run.app

# ─── Storage ────────────────────────────────────────────────────────────────
# Postgres. Neon's free tier is plenty; Cloud SQL works identically.
# Append ?sslmode=require&pgbouncer=true&connection_limit=1 for a pooled
# serverless connection — Cloud Run instances are short-lived and a full pool
# per instance will exhaust the database's connection limit.
DATABASE_URL="postgresql://user:pass@host/flaww?sslmode=require&pgbouncer=true&connection_limit=1"

# ─── Screening LLM ──────────────────────────────────────────────────────────
# The model ID lives in flaww.config.ts (screening.model), not here.
OPENAI_API_KEY=

# ─── Telegram ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Your numeric chat id — message @userinfobot to get it. Every other chat is ignored.
TELEGRAM_CHAT_ID=
# Used as both the webhook URL path segment and the header Telegram echoes back.
#   openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=

# ─── Cloud Scheduler ────────────────────────────────────────────────────────
# Shared secret sent as X-Flaww-Task-Secret on /tasks/* calls.
#   openssl rand -hex 24
TASKS_SECRET=

# ─── Reddit  (free) ─────────────────────────────────────────────────────────
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT="flaww/0.1 by /u/your_username"

# ─── Threads  (free) ────────────────────────────────────────────────────────
# Long-lived token from the Threads API. flaww refreshes it automatically at
# the 30-day mark and stores the rotated value in the database.
# Needs: threads_basic, threads_content_publish, threads_keyword_search
THREADS_ACCESS_TOKEN=

# ─── X  (pay per tweet read — leave blank to run without it) ────────────────
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REFRESH_TOKEN=

# ─── LinkedIn  (needs Community Management API approval) ────────────────────
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:xxxxxxxx

# ─── Ops ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# 1 = screen and ping, but never actually publish. Use for the first day.
DRY_RUN=0
