{
  "name": "flaww",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Human-in-the-loop social listening. Screens Reddit/Threads/X/LinkedIn, pings me on Telegram, posts my reply verbatim.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "doctor": "tsx src/scripts/doctor.ts",
    "threads:reset-auth": "tsx src/scripts/reset-threads-auth.ts",
    "corpus:export": "tsx src/scripts/export-corpus.ts",
    "corpus:stats": "tsx src/scripts/corpus-stats.ts",
    "poll": "tsx src/scripts/run-once.ts poll",
    "publish": "tsx src/scripts/run-once.ts publish",
    "deploy": "bash deploy/deploy.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "dotenv": "^16.4.7",
    "grammy": "^1.32.0",
    "openai": "^4.77.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
